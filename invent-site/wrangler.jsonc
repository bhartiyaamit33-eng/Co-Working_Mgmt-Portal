{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "iitbinvent",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "iitbinvent.com", "custom_domain": true },
    { "pattern": "www.iitbinvent.com", "custom_domain": true }
  ]
}
